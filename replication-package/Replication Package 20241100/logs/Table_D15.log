. * att_silence_ = 1 if the participant's recalled number of silent group members
. foreach var in rename_schools affirmative_action death_penalty immunizations{
  2.         gen att_silence_`var' = 0
  3.         forval i = 1/36{
  4.                 quietly count if e_`var' == . & zoom_id == `i'
  5.                 local n_s_`i' = r(N)
  6.                 replace att_silence_`var' = 1 if abs(recall_`var'_s - `n_s_`i'')<=1  & zoom_id ==
>  `i'
  7.         }
  8. }
