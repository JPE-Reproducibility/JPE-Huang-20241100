. cap file close b1

. file open b1 using "$output/appropriateness_summary.tex", write replace
(file /Users/yihong/Desktop/Silence Replicate Final/Output/appropriateness_summary.tex not found)

. 
. file write b1 "\begin{tabular}{l*{6}c}\toprule " _n

. file write b1 "Topic & Very Inappropriate & Somewhat Inappropriate & Neutral & Somewhat Appropriate 
> & Very Appropriate \\" _n

. file write b1 "\midrule" _n

. 
. forval i = 1/10 {
  2. 
.         local v  "`var`i''"
  3.         local nm "`lab`i''"
  4. 
.         qui count if norm_`v' < .
  5.         local N = r(N)
  6. 
.         * row percentages, and the modal category (shown in bold, as in the paper)
.         local best = -1
  7.         forval k = 1/5 {
  8.                 qui count if norm_`v' == `k'
  9.                 local p`k' = 100*r(N)/`N'
 10.                 if (`p`k'' > `best') {
 11.                         local best = `p`k''
 12.                         local mode = `k'
 13.                 }
 14.         }
 15. 
.         file write b1 "`nm'"
 16.         forval k = 1/5 {
 17.                 if (`k' == `mode')  file write b1 " & \textbf{" %4.2f (`p`k'') "}"
 18.                 else                file write b1 " & " %4.2f (`p`k'')
 19.         }
 20.         file write b1 " \\" _n
 21. }

. 
. file write b1 "\bottomrule" _n

. file write b1 "\end{tabular}" _n

. file close b1

. 
. forval i = 1/10 {
  2.         local v "`var`i''"
  3.         di _n as txt "{bf:`lab`i''}"
  4.         tab norm_`v'
  5. }

