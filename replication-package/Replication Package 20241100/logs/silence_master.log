. label var private_rename_schools "Rename Schools"

. label var private_affirmative_action "Affirmative Action"

. label var private_death_penalty "Death Penalty"

. label var private_immunizations "Immunizations"

. label var private_daylight_saving "DST"

. 
. foreach x of varlist private_rename_schools private_affirmative_action private_death_penalty private
> _immunizations private_daylight_saving {
  2.    sum `x' 
  3.    scalar mean_a = r(mean)
  4.    scalar sd_a = r(sd)
  5.    
.    sum `x' if treat == .
  6.    scalar mean_f = r(mean)  
  7.    scalar sd_f = r(sd)
  8.    
.    sum `x' if treat == 0
  9.    scalar mean_g = r(mean)  
 10.    scalar sd_g = r(sd)
 11.    
.    sum `x' if treat == 1
 12.    scalar mean_n = r(mean)  
 13.    scalar sd_n = r(sd)
 14.    
.    ttest `x', by(first_movers)
 15.    scalar p_1 = r(p)
 16.    
.    ttest `x', by(treat)
 17.    scalar p_2 = r(p)
 18.    
.    cap file close _all
 19.    file open myfile using "$output/summary_ftc.tex", write append
 20.    file write myfile "`: var label `x''" "&" %8.2f (mean_a) "&" %8.2f (mean_f) "&" %8.2f (mean_g)
>  ///
>    "&" %8.2f (mean_n) "&" %8.2f (p_1) "&" %8.2f (p_2)  "\\" 
 21.     file write myfile  "&" "(" %8.2f (sd_a) ")" "&" %8.2f "(" (sd_f) ")" "&" %8.2f "("(sd_g) ")" 
> ///
>    "&" %8.2f "(" (sd_n) ")" "&"  "&"   "\\" 
 22.    file close myfile
 23. }

