. 
. label var female "Female"

. label var year "Year"

. label var white "White"

. label var asian "Asian"

. label var ideology "Ideology"

. 
. foreach x of varlist female asian white year ideology {
  2.    sum `x' 
  3.    scalar mean_a = r(mean)
  4.    scalar sd_a = r(sd)
  5.    sum `x' if attr == 0
  6.    scalar mean_g = r(mean)  
  7.    scalar sd_g = r(sd)
  8.    sum `x' if attr == 1
  9.    scalar mean_n = r(mean)  
 10.    scalar sd_n = r(sd)
 11.    ttest `x', by(attr)
 12.    scalar p = r(p)
 13.    
.    cap file close _all
 14.    file open myfile using "$output/attrition.tex", write append
 15.    file write myfile "`: var label `x''" "&" %8.2f (mean_a) "&" %8.2f (sd_a) "&" %8.2f (mean_g) /
> //
>    "&" %8.2f (sd_g) "&" %8.2f (mean_n) "&" %8.2f (sd_n) "&" %8.2f (p) "\\" 
 16.    
.    file close myfile
 17. }

